{
  "_meta": {
    "purpose": "What each SDLC phase must produce before it can be approved, and where each artifact lives. Read by scripts/product-state.py (phase completion) and the pre-phase-advance hook (via the manifest), and by phase commands and agents to know canonical paths.",
    "how_to_use": "paths are globs relative to artifacts/<product>/. Each artifact has a level per scale profile (sdlc-config.json scale_profile; default enterprise): 'required' (the phase can't be approved without an approved copy), 'optional' (produce it when its note's trigger applies or the user asks), 'skip' (not produced at this profile). Phases with no required artifacts (implement, data, deploy produce code, verified by CI) are completed by the user's explicit phase approval alone. The five methodologies (DDD, Event Storming, TDD, BDD, SOLID) apply at every profile; lean produces fewer, shorter artifacts, never skips a methodology.",
    "profiles": [
      "lean",
      "standard",
      "enterprise"
    ],
    "phase_order": [
      "strategy",
      "ideate",
      "design",
      "implement",
      "data",
      "quality",
      "deploy",
      "customer-validation"
    ]
  },
