  "_meta": {
    "purpose": "What each SDLC phase must produce before it can be approved, and where each artifact lives. Read by scripts/product-state.py (phase completion) and the pre-phase-advance hook (via the manifest), and by phase commands and agents to know canonical paths.",
    "how_to_use": "paths are globs relative to artifacts/<product>/. A phase is complete when every artifact whose profile value is 'required' has at least one approved manifest entry matching one of its paths. Phases with no required artifacts (implement, data, deploy produce code, verified by CI) are completed by the user's explicit phase approval alone. 'optional' artifacts are produced when their note's trigger applies.",
    "profiles": [
      "enterprise"
    ],
    "phase_order": [
      "strategy",
      "ideate",
      "design",
      "implement",
      "data",
      "quality",
      "deploy",
      "customer-validation"
    ]
  },
