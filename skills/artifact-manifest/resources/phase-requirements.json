  "guidance": {
    "lean": {
      "approval_mode": "batch",
      "approval_mode_note": "Produce the phase's artifacts together, then present one summary table for a single review.",
      "implement": "One deployable service unless the domain clearly needs more; TDD and SOLID unchanged.",
      "deploy": "Single region, no service mesh, no chaos testing; a simple managed or single-cluster setup.",
      "quality": "End-to-end tests for the Must Have journeys; performance and load checks only against stated NFRs; no chaos or mutation runs."
    },
    "standard": {
      "approval_mode": "key-decisions",
      "approval_mode_note": "Stop for approval only at the artifacts that change direction (e.g. vision, Context Map, Container Diagram); batch the rest into one review per phase.",
      "implement": "A few services along Bounded Context lines.",
      "deploy": "One region; service mesh optional; canary releases.",
      "quality": "Full Test Pyramid; mutation testing on critical packages; chaos testing optional."
    },
    "enterprise": {
      "approval_mode": "per-artifact",
      "approval_mode_note": "Stop for approval after every artifact (today's behaviour).",
      "implement": "Services per Bounded Context; tenancy isolation per the multi-tenancy design.",
      "deploy": "Multi-region / high availability per the NFRs; service mesh (mTLS); canary and blue-green; DR drills.",
      "quality": "Full Test Pyramid plus performance, load, chaos and mutation testing; compliance verification."
    }
  }
}
